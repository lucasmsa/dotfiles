# ~/.gitconfig — Lucas Moreira
# Personal identity only. Any per-directory override lives in a machine-local
# include that is never committed here, so this file carries no employer address.

[user]
	name = Lucas Moreira
	email = lucasmsea@outlook.com

[core]
	editor = zed --wait

[init]
	defaultBranch = main

[pull]
	rebase = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
