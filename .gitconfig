# ~/.gitconfig — Lucas Moreira
# Personal identity is the default. Work directories override it through
# ~/.gitconfig-work, which is machine-local and never committed here, so this
# file carries no employer address.

[user]
	name = Lucas Moreira
	email = lucasmsea@outlook.com

[includeIf "gitdir:~/Main/koltin/"]
	path = ~/.gitconfig-work

[core]
	editor = zed --wait

[init]
	defaultBranch = main

[pull]
	rebase = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
